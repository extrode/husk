    <OutputType>Exe</OutputType>
    <RootNamespace>Extrode.Husk.Deploy</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Extrode.Husk.Tests" />
  </ItemGroup>
</Project>
