<Project Sdk="Microsoft.NET.Sdk">
  <!-- MSBuild task package. Loads in-process under the .NET SDK's MSBuild (`dotnet build`), and in
       MSBuild 18's .NET task host under Visual Studio's MSBuild (build/Extrode.Husk.Build.targets).
       The compiler, ClearScript and its six natives ship beside the task, under tasks/, with the
       compiler's deps.json: the Development app loads the compiler from there (docs/architecture/003). -->
  <PropertyGroup>
    <RootNamespace>Extrode.Husk.Build</RootNamespace>
    <PackageId>Extrode.Husk.Build</PackageId>
    <Description>Compiles Svelte components to ES modules during dotnet build, in an embedded V8. No Node. Builds on Extrode.Pare.Build, which the project references too.</Description>
    <DevelopmentDependency>true</DevelopmentDependency>
    <PackageTags>svelte;msbuild;aspnetcore;v8</PackageTags>
    <BuildOutputTargetFolder>tasks</BuildOutputTargetFolder>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_HuskCompilerInPackage</TargetsForTfmSpecificContentInPackage>
    <!-- NU5100: the dlls under tasks/ are meant to sit outside lib/. -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
    <_HuskCompilerOutput>$(MSBuildThisFileDirectory)..\Extrode.Husk.Compiler\bin\$(Configuration)\$(TargetFramework)\</_HuskCompilerOutput>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Extrode.Husk.Compiler\Extrode.Husk.Compiler.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="build\*" Pack="true" PackagePath="build" />
    <None Include="NOTICE.md" Pack="true" PackagePath="" />
    <None Include="..\..\third-party\svelte-5.57.2\**" Pack="true" PackagePath="third-party/svelte-5.57.2/" Visible="false" />
    <None Include="$(NuGetPackageRoot)microsoft.clearscript.v8/$(ClearScriptVersion)/License.txt" Pack="true" PackagePath="third-party/clearscript-$(ClearScriptVersion)/" Visible="false" />
    <None Include="$(NuGetPackageRoot)microsoft.clearscript.v8/$(ClearScriptVersion)/licenses/V8/*" Pack="true" PackagePath="third-party/clearscript-$(ClearScriptVersion)/V8/" Visible="false" />
    <None Include="$(NuGetPackageRoot)newtonsoft.json/13.0.3/LICENSE.md" Pack="true" PackagePath="third-party/newtonsoft.json-13.0.3/" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Extrode.Husk.Tests" />
  </ItemGroup>

  <!-- The compiler's whole output, natives under runtimes/ included, goes next to the task. -->
  <Target Name="_HuskCompilerInPackage">
    <ItemGroup>
      <_HuskCompilerFile Include="$(_HuskCompilerOutput)**" Exclude="$(_HuskCompilerOutput)*.runtimeconfig.json" />
      <TfmSpecificPackageFile Include="@(_HuskCompilerFile)" PackagePath="tasks/$(TargetFramework)/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
    <Error Condition="!Exists('$(_HuskCompilerOutput)runtimes/osx-arm64/native/ClearScriptV8.osx-arm64.dylib')"
           Text="The compiler's output at $(_HuskCompilerOutput) has no natives; build Extrode.Husk.Compiler first." />
  </Target>
</Project>
