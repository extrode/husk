<Project Sdk="Microsoft.NET.Sdk">
  <!-- MSBuild task package. Loads in-process under the .NET SDK's MSBuild (`dotnet build`), and in
       MSBuild 18's .NET task host under Visual Studio's MSBuild (build/Extrode.Husk.Build.targets).
       The compiler and ClearScript ship beside the task, under tasks/, with the compiler's deps.json:
       the Development app loads the compiler from there (docs/architecture/003). The six V8 natives
       are dependencies, not files in the package (see NativeProbe). -->
  <PropertyGroup>
    <RootNamespace>Extrode.Husk.Build</RootNamespace>
    <PackageId>Extrode.Husk.Build</PackageId>
    <Description>Compiles Svelte components to ES modules during dotnet build, in an embedded V8. No Node. Builds on Extrode.Pare.Build, which it brings in.</Description>
    <DevelopmentDependency>true</DevelopmentDependency>
    <PackageTags>svelte;msbuild;aspnetcore;v8</PackageTags>
    <BuildOutputTargetFolder>tasks</BuildOutputTargetFolder>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_HuskCompilerInPackage</TargetsForTfmSpecificContentInPackage>
    <!-- NU5100: the dlls under tasks/ are meant to sit outside lib/. NU5128: the dependency group has no lib/ to match. -->
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
    <!-- ClearScript's dependency, whose license ships too; the pack fails when the compiler resolves another. -->
    <_HuskNewtonsoftVersion>13.0.3</_HuskNewtonsoftVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <!-- The natives are not packed: the package depends on Microsoft's six and takes no assets from them,
         so they restore into the NuGet cache, where NativeProbe finds the build machine's. -->
    <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-arm64" VersionOverride="[$(ClearScriptVersion)]" ExcludeAssets="runtime;compile;native;contentfiles;analyzers" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-x64" VersionOverride="[$(ClearScriptVersion)]" ExcludeAssets="runtime;compile;native;contentfiles;analyzers" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.osx-arm64" VersionOverride="[$(ClearScriptVersion)]" ExcludeAssets="runtime;compile;native;contentfiles;analyzers" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.osx-x64" VersionOverride="[$(ClearScriptVersion)]" ExcludeAssets="runtime;compile;native;contentfiles;analyzers" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-arm64" VersionOverride="[$(ClearScriptVersion)]" ExcludeAssets="runtime;compile;native;contentfiles;analyzers" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" VersionOverride="[$(ClearScriptVersion)]" ExcludeAssets="runtime;compile;native;contentfiles;analyzers" />
  </ItemGroup>
  <ItemGroup>
    <!-- A dependency, so its buildTransitive/ imports Pare's targets into the app: the app needs no
         reference of its own. Pare.Build is a developmentDependency, whose default PrivateAssets="all"
         would write no dependency; this one excludes only what must not flow. -->
    <PackageReference Include="Extrode.Pare.Build" PrivateAssets="contentfiles;analyzers;build" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Extrode.Husk.Compiler\Extrode.Husk.Compiler.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="build\*" Pack="true" PackagePath="build" />
    <None Include="runtime\**" Pack="true" PackagePath="runtime" />
    <None Include="NOTICE.md" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\docs\assets\logo\husk-icon-128.png" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\third-party\svelte-5.57.3\**" Pack="true" PackagePath="third-party/svelte-5.57.3/" Visible="false" />
    <None Include="$(NuGetPackageRoot)microsoft.clearscript.v8/$(ClearScriptVersion)/License.txt" Pack="true" PackagePath="third-party/clearscript-$(ClearScriptVersion)/" Visible="false" />
    <None Include="$(NuGetPackageRoot)microsoft.clearscript.v8/$(ClearScriptVersion)/licenses/V8/*" Pack="true" PackagePath="third-party/clearscript-$(ClearScriptVersion)/V8/" Visible="false" />
    <None Include="$(NuGetPackageRoot)newtonsoft.json/$(_HuskNewtonsoftVersion)/LICENSE.md" Pack="true" PackagePath="third-party/newtonsoft.json-$(_HuskNewtonsoftVersion)/" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Extrode.Husk.Tests" />
  </ItemGroup>

  <!-- The compiler's output goes next to the task, without the natives under runtimes/: they come from the dependencies above. -->
  <Target Name="_HuskCompilerInPackage">
    <MSBuild Projects="..\Extrode.Husk.Compiler\Extrode.Husk.Compiler.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" PropertyName="_HuskCompilerDll" />
    </MSBuild>
    <PropertyGroup>
      <_HuskCompilerOutput>$([System.IO.Path]::GetDirectoryName('$(_HuskCompilerDll)'))/</_HuskCompilerOutput>
      <_HuskCompilerDeps>$([System.IO.File]::ReadAllText('$(_HuskCompilerOutput)Extrode.Husk.Compiler.deps.json'))</_HuskCompilerDeps>
    </PropertyGroup>
    <Error Condition="!$(_HuskCompilerDeps.Contains('&quot;Newtonsoft.Json/$(_HuskNewtonsoftVersion)&quot;'))"
           Text="The compiler no longer resolves Newtonsoft.Json $(_HuskNewtonsoftVersion): update _HuskNewtonsoftVersion and NOTICE.md." />
    <PropertyGroup>
      <_HuskTargetsText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/build/Extrode.Husk.Build.targets'))</_HuskTargetsText>
    </PropertyGroup>
    <Error Condition="!$(_HuskTargetsText.Contains('&lt;_HuskClearScriptVersion&gt;$(ClearScriptVersion)&lt;/_HuskClearScriptVersion&gt;'))"
           Text="build/Extrode.Husk.Build.targets names another ClearScript version than ClearScriptVersion $(ClearScriptVersion)." />
    <ItemGroup>
      <_HuskCompilerFile Include="$(_HuskCompilerOutput)**" Exclude="$(_HuskCompilerOutput)*.runtimeconfig.json;$(_HuskCompilerOutput)runtimes/**" />
      <TfmSpecificPackageFile Include="@(_HuskCompilerFile)" PackagePath="tasks/$(TargetFramework)/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>
</Project>
