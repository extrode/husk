<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- References no ClearScript, unless WithClearScript=true (a second copy in the default context). -->
  <PropertyGroup>
    <PublishAot Condition="'$(Aot)' == 'true'">true</PublishAot>
    <DefineConstants Condition="'$(WithClearScript)' == 'true'">$(DefineConstants);WITH_CLEARSCRIPT</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(WithClearScript)' == 'true'">
    <PackageReference Include="Microsoft.ClearScript.V8" Version="7.5.1.1" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.osx-arm64" Version="7.5.1.1" />
  </ItemGroup>
</Project>
