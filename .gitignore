# Worktrees. `.worktrees/` is ours; `.claude/worktrees/` is where the
# built-in EnterWorktree tool puts them and is not configurable. A worktree is
# a full checkout, so one left unignored doubles the repo on the next add -A.
.worktrees/

.claude/worktrees/

# Scratch: probes, screenshots, dumps. The one directory an agent may delete
# without asking, which is why it is the only place scratch goes.
tmp/

# .NET and npm build output, and the prototypes' generated files.
bin/
obj/
node_modules/
prototypes/*/msbuild-task/app/wwwroot/js/
prototypes/*/*.tsv
prototypes/*/*.txt
