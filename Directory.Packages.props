<Project>
  <!-- Central Package Management. Every package here was approved before it was added (AGENTS.md).
       The MSBuild packages are compile-only in Extrode.Husk.Build: the host supplies them. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ClearScriptVersion>7.5.1.1</ClearScriptVersion>
    <PareVersion>0.6.1</PareVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Extrode.Pare" Version="$(PareVersion)" />
    <PackageVersion Include="Extrode.Pare.AspNetCore" Version="$(PareVersion)" />
    <PackageVersion Include="Extrode.Pare.Build" Version="$(PareVersion)" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.9.6" />
    <PackageVersion Include="Microsoft.ClearScript.V8" Version="$(ClearScriptVersion)" />
    <PackageVersion Include="Microsoft.ClearScript.V8.Native.linux-arm64" Version="$(ClearScriptVersion)" />
    <PackageVersion Include="Microsoft.ClearScript.V8.Native.linux-x64" Version="$(ClearScriptVersion)" />
    <PackageVersion Include="Microsoft.ClearScript.V8.Native.osx-arm64" Version="$(ClearScriptVersion)" />
    <PackageVersion Include="Microsoft.ClearScript.V8.Native.osx-x64" Version="$(ClearScriptVersion)" />
    <PackageVersion Include="Microsoft.ClearScript.V8.Native.win-arm64" Version="$(ClearScriptVersion)" />
    <PackageVersion Include="Microsoft.ClearScript.V8.Native.win-x64" Version="$(ClearScriptVersion)" />
    <PackageVersion Include="Selenium.WebDriver" Version="4.51.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
