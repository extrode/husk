<Project>
  <!-- LangVersion is pinned, not "latest", so a newer local SDK cannot silently change overload
       resolution. Raising it is a commit. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>10.0</AnalysisLevel>
    <Version>0.1.0-preview.5</Version>
    <Authors>Extrode</Authors>
    <Company>Extrode</Company>
    <Copyright>Copyright (c) 2026 Extrode (extrode.com)</Copyright>
    <RepositoryUrl>https://github.com/extrode/husk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://husk.extrode.com</PackageProjectUrl>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>husk-icon-128.png</PackageIcon>
  </PropertyGroup>
</Project>
